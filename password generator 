import random
import string

def generate_password(length):
    # Har category se kam se kam ek character lena zaroori hai
    chars = string.ascii_letters + string.digits + string.punctuation
    while True:
        password = "".join(random.choice(chars) for _ in range(length))
        has_lower = any(c.islower() for c in password)
        has_upper = any(c.isupper() for c in password)
        has_digit = any(c.isdigit() for c in password)
        has_special = any(c in string.punctuation for c in password)
        if has_lower and has_upper and has_digit and has_special:
            return password

length = int(input("Length of password (minimum 8): "))
while length < 8:
    length = int(input("Minimum 8 character: "))

count = int(input("How many password you wil generate: "))

for i in range(count):
    print(f"Password {i + 1}: {generate_password(length)}")